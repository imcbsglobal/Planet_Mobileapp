{
  "expo": {
    "name": "Planet",
    "slug": "MY-IMC",
    "version": "5.2.5",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo_IF.png",
    "scheme": "imcmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/loo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff6c00"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "35",
      "bundleIdentifier": "com.myimc2006.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "my.myimc.in": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "1.0",
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to allow users to upload bills, receipts, and screenshots as proof for work-related activities within their company account.",
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to record employee Punch In and Punch Out attendance and to auto-detect the shop location when submitting an enquiry.",
        "NSCameraUsageDescription": "This app requires access to your camera to capture photos of bills, receipts, and work-related documents for upload within the app.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record voice notes for enquiries."
      }
    },
    "android": {
      "versionCode": 36,
      "icon": "./assets/images/app_logo_IF.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_logo_IF.png",
        "backgroundColor": "#ff6c00"
      },
      "package": "com.myimc2006.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/app_logo_IF.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app_logo_IF.png",
          "color": "#F5C451"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app requires access to your location to record employee Punch In and Punch Out attendance and to auto-detect the shop location when submitting an enquiry."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "876c6f71-1467-443f-bc8f-227de54de1e2"
      }
    }
  }
}
