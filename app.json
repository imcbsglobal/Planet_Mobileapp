{
  "expo": {
    "name": "MY IMC",
    "slug": "MY-IMC",
    "version": "4.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo_IF.png",
    "scheme": "imcmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/loo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff6c00"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "10",
      "bundleIdentifier": "com.myimc2006.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "myimc.in": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "1.0",
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to allow users to upload bills, receipts, and screenshots as proof for work-related activities within their company account.",
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to record employee Punch In and Punch Out attendance based on their current work location as part of the company's attendance tracking system.",
        "NSCameraUsageDescription": "This app requires access to your camera to capture photos of bills, receipts, and work-related documents for upload within the app."
      }
    },
    "android": {
      "versionCode": 11,
      "icon": "./assets/images/app_logo_IF.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_logo_IF.png",
        "backgroundColor": "#ff6c00"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.myimc2006.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app_logo_IF.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "requestLegacyExternalStorage": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app_logo_IF.png",
          "color": "#F5C451"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "876c6f71-1467-443f-bc8f-227de54de1e2"
      }
    }
  }
}
